  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
